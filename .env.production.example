# Copy to .env.production and replace with a private, alphanumeric value (32+ characters).
POSTGRES_USER=deadlock
POSTGRES_PASSWORD=replace-with-a-private-random-password
POSTGRES_DB=deadlock
WEB_PORT=8080
DEPENDENCY_TIMEOUT_SECONDS=2
# Set only when a reverse proxy connects from these trusted CIDRs, as a JSON array.
TRUSTED_PROXY_NETWORKS=[]
STEAM_API_KEY=
